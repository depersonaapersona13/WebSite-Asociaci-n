# _headers — cabeceras HTTP de Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/)
# Si algo deja de funcionar tras el despliegue, comenta la línea Content-Security-Policy
# y descomenta la versión estricta cuando migres a Tailwind compilado (ver README).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'

# Versión más estricta (requiere Tailwind compilado y sin 'unsafe-inline'):
# Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'

/assets/video/*
  Cache-Control: public, max-age=604800

/assets/img/*
  Cache-Control: public, max-age=604800

/assets/css/*
  Cache-Control: public, max-age=3600

/assets/js/*
  Cache-Control: public, max-age=3600

/data/*
  Cache-Control: public, max-age=300

/*.html
  Cache-Control: public, max-age=0, must-revalidate